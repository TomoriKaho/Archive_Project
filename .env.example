# 数据库
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/mydb

# 向量库 / Ollama
QDRANT_URL=http://qdrant:6333
QDRANT_PORT=6333
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_MODELS=qwen3-embedding:8b

# 服务端口
BACKEND_PORT=18000
FRONTEND_ADMIN_PORT=8080
FRONTEND_CLIENT_PORT=8081

# 前端 API
VUE_APP_API_BASE_URL=http://localhost:18000/api
VUE_APP_ADMIN_TOKEN_STORAGE_KEY=archive_ai_admin_token
VUE_APP_CLIENT_TOKEN_STORAGE_KEY=archive_ai_client_token

# 认证
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INITIAL_ADMIN_EMAIL=admin@example.com
ADMIN_INIT_PASSWORD=ChangeMe123

# RAG（如未使用可先保留默认）
QDRANT_COLLECTION=VOC_Archives
QDRANT_VECTOR_SIZE=4096 # set to the embedding vector size used by Ollama
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
CHAT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=sk-your-api-key
CHAT_MODEL=qwen3-vl-plus
RAG_TOP_K=20
RAG_OLLAMA_TIMEOUT=60
RAG_CHUNK_MEMORY_WINDOW_MULTIPLIER=3 # 上下文记忆窗口倍数
STRING_MATCH_MAX_PER_ID=10      # 每个文档 ID 最多匹配的 chunk 数量
NEIGHBOR_WINDOW_SIZE=1          # 邻居窗口大小
NEIGHBOR_MAX_TOTAL_CHUNKS=100   # 每个邻居最多使用的 chunk 数量

# 机器翻译（传统搜索启用中文搜索时使用）
TRANSLATION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TRANSLATION_API_KEY=sk-your-translation-api-key
TRANSLATION_MODEL=qwen-mt-lite
TRANSLATION_API_TIMEOUT=20

# 向量入库批量配置
DOCUMENT_INDEX_BATCH_SIZE=64

# CSV 解析
CSV_FIELD_SIZE_LIMIT=10485760

# 超大档案 PDF 分片上传（服务端）
ARCHIVE_UPLOAD_CHUNK_BYTES=8388608
ARCHIVE_UPLOAD_MAX_CHUNK_BYTES=16777216
ARCHIVE_UPLOAD_MAX_FILE_BYTES=10737418240

# 西印度档案常驻上传脚本（只在运行脚本的本机填写）
ARCHIVE_API_BASE_URL=https://apsr.pku.edu.cn/api
ARCHIVE_ADMIN_EMAIL=
ARCHIVE_ADMIN_PASSWORD=
ARCHIVE_DOCUMENT_TITLE=西印度档案总馆20260722
# 已知 UUID 时建议填写，以免依赖标题查找
ARCHIVE_DOCUMENT_UUID=
